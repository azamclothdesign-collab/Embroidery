# ---- Runtime ----
NODE_ENV=production
HOST=127.0.0.1
PORT=4000

# ---- Database ----
DATABASE_URL=postgres://embroidery:CHANGE_ME@127.0.0.1:5432/embroidery
DB_POOL_MAX=10

# ---- Public URLs (no trailing slash) ----
# Customers' browser origin. Payment callbacks (/hooks/*) and downloads (/dl/*)
# are routed by nginx from this same origin to the backend.
SITE_URL=https://embdesigens.com

# ---- Secrets (generate each with: openssl rand -base64 48) ----
# Shared with the Next.js server only. Never expose to browsers.
INTERNAL_API_KEY=
# Exactly 32 bytes, base64 (openssl rand -base64 32). Encrypts gateway keys + SMTP password.
# Changing it later makes saved gateway keys unreadable (re-enter them in admin).
SETTINGS_ENCRYPTION_KEY=
# Signs short-lived download links.
DOWNLOAD_SIGNING_KEY=

# ---- Files ----
# Outside the web root. Must be writable by the app user.
STORAGE_DIR=/var/lib/embroidery/storage
MAX_ZIP_MB=200

# ---- First admin (used ONLY when no admin exists yet) ----
# After first login you are forced to change email/password; then remove these.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ---- Email fallback (admin → Settings → Email overrides these) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
