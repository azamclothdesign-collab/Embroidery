{
  "name": "embroidery-store-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "migrate": "node --env-file=.env src/scripts/migrate.ts",
    "cleanup": "node --env-file=.env src/scripts/cleanup.ts",
    "import:legacy": "node --env-file=.env src/scripts/importLegacy.ts",
    "import:repo": "node --env-file=.env src/scripts/importFromLegacyRepo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.6.1",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "sharp": "^0.34.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}
