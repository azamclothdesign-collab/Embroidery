{
  "name": "embroidery-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "compressAssets": "node --experimental-strip-types scripts/compressAssets.ts",
    "checkBudgets": "node --experimental-strip-types scripts/checkBundleBudget.ts",
    "ci": "npm run typecheck && npm run lint && npm run compressAssets -- --check && npm run build && npm run checkBudgets",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ],
    "public/assets/source/**/*.{png,jpg,jpeg,tif,tiff,webp}": [
      "node --experimental-strip-types scripts/compressAssets.ts"
    ]
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
