{
  "name": "embroidery-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import ./scripts/registerTsResolve.mjs --experimental-strip-types --watch src/index.ts",
    "start": "node --import ./scripts/registerTsResolve.mjs --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "npm --prefix ../Database run migrate",
    "seed": "node --import ./scripts/registerTsResolve.mjs --experimental-strip-types scripts/seedCatalog.ts",
    "ci": "npm run typecheck"
  },
  "dependencies": {
    "pg": "8.16.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}
