API_BASE_URL=http://localhost:4000
HMAC_SIGNING_SECRET=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/embroidery
# DATABASE_MIGRATION_URL=
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development
# Optional absolute path for admin image uploads (defaults to Frontend/public/uploads).
# UPLOAD_DIR=
# HMAC_SIGNING_SECRET must match Frontend/.env.local (min 32 chars).

# Contact form inbox (defaults to azamclothdesign@gmail.com)
CONTACT_INBOX=azamclothdesign@gmail.com

# SMTP — required to email contact form submissions to CONTACT_INBOX.
# For Gmail: use an App Password (Google Account → Security → App passwords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=azamclothdesign@gmail.com
# SMTP_PASS=
# SMTP_FROM="Embroidery Support <azamclothdesign@gmail.com>"
